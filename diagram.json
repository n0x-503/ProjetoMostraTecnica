{
  "version": 1,
  "author": "Seu Nome",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-tm1637", "id": "display", "top": -150, "left": -200, "attrs": {} },
    { "type": "wokwi-dht22", "id": "sensor", "top": -150, "left": 150, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "rele", "top": 150, "left": 120, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": 150, "left": -100, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "resistor", "top": 220, "left": -100, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:GND.1", "display:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "display:VCC", "red", [ "v0" ] ],
