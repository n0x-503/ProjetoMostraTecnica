    [ "esp:D23", "display:DIO", "orange", [ "v0" ] ],

    [ "esp:GND.2", "sensor:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "sensor:VCC", "red", [ "v0" ] ],
    [ "esp:D15", "sensor:SDA", "blue", [ "v0" ] ],

    [ "esp:GND.2", "rele:GND", "black", [ "v0" ] ],
    [ "esp:VIN", "rele:VCC", "red", [ "v0" ] ],
    [ "esp:D4", "rele:IN", "purple", [ "v0" ] ],

    [ "esp:D5", "led:Anode", "green", [ "v0" ] ],
    [ "led:Cathode", "resistor:1", "black", [ "v0" ] ],
    [ "resistor:2", "esp:GND.1", "black", [ "v0" ] ]
